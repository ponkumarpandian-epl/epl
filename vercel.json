{
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "installCommand": "npm ci --prefix ../..",
      "buildCommand": "npm run build --workspace @epl/web --prefix ../..",
      "outputDirectory": ".next"
    },
    "api": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "apps/api/src/Epl.Api/Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/identity/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
